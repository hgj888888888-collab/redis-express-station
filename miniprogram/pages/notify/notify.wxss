.notice-tip {
  font-size: 23rpx;
  color: #8A93A6;
  line-height: 1.6;
}

.notice-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1E4FD8;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1F36;
  flex: 1;
}

.notice-time {
  font-size: 22rpx;
  color: #A0A9BC;
}

.notice-content {
  font-size: 25rpx;
  color: #5C6784;
  line-height: 1.7;
  padding-left: 24rpx;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #A7B0C2;
  padding: 10rpx 0 30rpx;
}
