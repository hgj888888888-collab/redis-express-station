<view class="page">
  <view class="card">
    <view class="card-title">
      <text>管理员登录</text>
      <text class="sub">驿站工作人员</text>
    </view>
    <view class="field-label">账号</view>
    <input class="input" value="{{username}}" bindinput="onUsernameInput" placeholder="请输入管理员账号" />
    <view class="field-label">密码</view>
    <input class="input" password value="{{password}}" bindinput="onPasswordInput" placeholder="请输入密码" />
    <button class="btn" bindtap="submit" loading="{{submitting}}">登录</button>
    <view class="login-tip">演示账号：admin / 123456</view>
  </view>
</view>
