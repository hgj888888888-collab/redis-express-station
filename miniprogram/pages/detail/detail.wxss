.head-card {
  background: linear-gradient(135deg, #1E4FD8 0%, #3A6BF0 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.head-courier {
  font-size: 34rpx;
  font-weight: 600;
}

.head-no {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.code-box {
  text-align: center;
  padding: 20rpx 0 24rpx;
}

.code-text {
  font-size: 72rpx;
  font-weight: 600;
  letter-spacing: 14rpx;
  color: #1E4FD8;
  margin-bottom: 10rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F5FA;
  font-size: 26rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #8A93A6;
}

.lamp-box {
  display: flex;
  align-items: center;
  padding: 16rpx 0 24rpx;
}

.lamp {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E3E7F0;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.lamp.on {
  background: #FFB020;
  box-shadow: 0 0 0 10rpx rgba(255, 176, 32, 0.18), 0 0 32rpx rgba(255, 176, 32, 0.75);
  animation: lamp-breathe 1.2s ease-in-out infinite;
}

@keyframes lamp-breathe {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.55;
    transform: scale(0.92);
  }
}

.lamp-shelf {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E2A44;
}

.lamp-info .muted {
  font-size: 22rpx;
  color: #8A93A6;
  margin-top: 6rpx;
}

.tip-card {
  background: #FFF8E8;
  color: #A9740A;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
