.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(30, 79, 216, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-text {
  font-size: 26rpx;
  color: #8A93A6;
}

.tab-item.active .tab-text {
  color: #1E4FD8;
  font-weight: 600;
}

.tab-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1E4FD8;
  margin-top: 8rpx;
}
