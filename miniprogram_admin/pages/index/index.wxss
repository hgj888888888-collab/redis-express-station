.hero {
  background: linear-gradient(135deg, #1E4FD8 0%, #3A6BF0 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.78;
  margin-top: 8rpx;
}

.user-bar {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.user-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  color: #FFFFFF;
}

.user-btn {
  margin-left: 16rpx;
  background: #FFFFFF;
  color: #1E4FD8;
  font-size: 24rpx;
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
}

.quick-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #1E4FD8;
  box-shadow: 0 6rpx 18rpx rgba(30, 79, 216, 0.06);
}

.quick-title {
  font-size: 30rpx;
  font-weight: 600;
}

.quick-sub {
  font-size: 23rpx;
  color: #8A93A6;
  margin-top: 6rpx;
}

.quick-arrow {
  font-size: 44rpx;
  color: #B9C5E2;
}

.notify-badge {
  display: inline-block;
  min-width: 32rpx;
  padding: 0 8rpx;
  margin-left: 10rpx;
  background: #D94A4A;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  vertical-align: middle;
}

.parcel-item {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0F3FA;
}

.parcel-item:last-child {
  border-bottom: none;
}

.parcel-line1 {
  display: flex;
  align-items: center;
}

.courier {
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 14rpx;
}

.parcel-line2 {
  font-size: 24rpx;
  color: #5C6784;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.parcel-line3 {
  font-size: 23rpx;
  color: #A0A9BC;
  margin-top: 8rpx;
}

.parcel-code {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E4FD8;
  letter-spacing: 2rpx;
  margin-top: 6rpx;
}

.more-link {
  text-align: center;
  font-size: 24rpx;
  color: #1E4FD8;
  padding-top: 22rpx;
}

.dot {
  margin: 0 8rpx;
}

.parcel-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.parcel-time {
  font-size: 21rpx;
  color: #A0A9BC;
}

.parcel-arrow {
  font-size: 34rpx;
  color: #C6D0E4;
  margin-top: 10rpx;
}

.footer-tip {
  text-align: center;
  color: #B3BBCB;
  font-size: 22rpx;
  margin-top: 10rpx;
}

.admin-entry {
  text-align: center;
  font-size: 24rpx;
  color: #8A93A6;
  padding: 20rpx 0 4rpx;
}
